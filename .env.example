# Copia questo file in `.env` (stessa cartella) e compila. `.env` resta solo sul
# tuo computer: è nel .gitignore, non finisce su GitHub e non finisce nel codice.

# Gateway OpenAI-compatibile a cui il micro-server chiede di leggere la busta.
GALENE_BASE_URL=https://models.galene.ai/v1
# Modello da usare (deve essere abilitato sul gateway).
GALENE_MODELLO=Galene/DeepSeek-V4-Flash
# Chiave del gateway. Di solito NON serve scriverla qui: il micro-server la prende
# già da ~/.hermes/.env (LITELLM_EXT_API_KEY). Scrivila solo su un altro computer.
# MAI nel codice, MAI nel frontend.
#LITELLM_EXT_API_KEY=sk-xxxxxxxxxxxxxxxx
# Porta locale del micro-server (ascolta solo su 127.0.0.1).
#INQUADRA_PORTA=8791
# Token per il link condiviso ("Condividi Inquadra col collega.command"): senza
# ?t=<token> il modello non risponde. Generane uno: openssl rand -hex 8
#INQUADRA_TOKEN=mio-token-casuale
